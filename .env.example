# ==============================================================================
# HORIZON ECOSYSTEM — MASTER ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this template for local setup and Vercel environment deployment.
# Copy to .env (root) or apps/web/.env (for client-side VITE_ prefixed keys).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Realtime Database
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 2. Sarvam AI Intelligent Recovery Agent
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=sarvam-105b

# ------------------------------------------------------------------------------
# 3. MST Blockchain Testnet & Operator Keypairs
# ------------------------------------------------------------------------------
MST_TESTNET_RPC=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037
AUTHORIZED_WALLETS=0xYourAuthorizedWallet1,0xYourAuthorizedWallet2
OPERATOR_PRIVATE_KEY=0xyour_testnet_operator_private_key
MIN_BALANCE=0.1

# ------------------------------------------------------------------------------
# 4. Engine & Security Configuration
# ------------------------------------------------------------------------------
TICK_SECRET=your_secret_tick_key
DEMO_MODE=false
ENVIRONMENT=production
