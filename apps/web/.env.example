# ==============================================================================
# HORIZON WEB — ENVIRONMENT CONFIGURATION (Vite / Frontend)
# ==============================================================================
# In Vercel, add these keys under: Project Settings -> Environment Variables.
# In local development, copy this file to: apps/web/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Service
# ------------------------------------------------------------------------------
# URL of the Horizon FastAPI backend. In local dev, defaults to http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Firebase Authentication & Realtime Database
# ------------------------------------------------------------------------------
# Found in: Firebase Console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=horizon-recovery.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=horizon-recovery
VITE_FIREBASE_STORAGE_BUCKET=horizon-recovery.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Realtime Database URL (Realtime Database -> Data tab)
VITE_FIREBASE_DATABASE_URL=https://horizon-recovery-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 3. Web3 & Blockchain (NFT Subscriptions & Audit Vault)
# ------------------------------------------------------------------------------
# Ethereum / Polygon / Sepolia RPC endpoint (Infura, Alchemy, or public RPC)
VITE_WEB3_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key
VITE_CHAIN_ID=11155111

# Deployed Horizon ERC-721 Subscription NFT smart contract address
VITE_SUBSCRIPTION_NFT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed Horizon On-Chain Audit Vault smart contract address
VITE_AUDIT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ------------------------------------------------------------------------------
# 4. Feature Toggles & Environment
# ------------------------------------------------------------------------------
# When true, the UI provides instant demo sign-in and mock fallbacks if live services are offline
VITE_ENABLE_MOCK_FALLBACK=true
VITE_ENVIRONMENT=production
