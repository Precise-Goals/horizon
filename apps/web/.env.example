# ==============================================================================
# HORIZON MONOLITHIC WEB RUNTIME — VITE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Vercel, configure these variables in: Project Settings -> Environment Variables.
# In local development, copy this template to apps/web/.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Realtime Database
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 2. MST Blockchain Testnet & Operator Wallet Integration (BridgeKey)
# ------------------------------------------------------------------------------
VITE_MST_TESTNET_RPC=https://testnetrpc.mstblockchain.com
VITE_MST_CHAIN_ID=91562037
VITE_AUTHORIZED_WALLETS=0xYourAuthorizedWallet1,0xYourAuthorizedWallet2
VITE_OPERATOR_PRIVATE_KEY=0xyour_testnet_operator_private_key
VITE_MIN_BALANCE=0.1

# ------------------------------------------------------------------------------
# 3. Sarvam AI Intelligent Copilot (sarvam-105b)
# ------------------------------------------------------------------------------
VITE_SARVAM_API_KEY=your_sarvam_api_key
VITE_SARVAM_BASE_URL=https://api.sarvam.ai
VITE_SARVAM_MODEL=sarvam-105b

# ------------------------------------------------------------------------------
# 4. App & API Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE=/api/v1
VITE_DEMO_MODE=false
VITE_ENVIRONMENT=production
